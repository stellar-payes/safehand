# Soroban RPC node used for read-only contract calls and event indexing.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Postgres (see docker-compose.yml).
DATABASE_URL=postgres://safehand:safehand@localhost:5432/safehand

# Contract IDs from `contracts/scripts/deploy.sh` output.
ESCROW_CONTRACT_ID=
ARBITER_REGISTRY_CONTRACT_ID=

# Notifications (optional; state changes are logged when unset).
TWILIO_SID=
TWILIO_TOKEN=

# Base URL of the web app, used to build deal share links.
APP_BASE_URL=http://localhost:3000

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
